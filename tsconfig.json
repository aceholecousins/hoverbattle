{
	"compilerOptions": {
		"target": "ES6",
		"lib": ["DOM", "ScriptHost"],
		"moduleResolution": "bundler",
		"outDir": "./dist/",
		"noImplicitAny": true,
		"preserveConstEnums": true,
		"sourceMap": true,
		"allowJs": true,
		"incremental": true,
		"strict": true,
		"types": ["node"],
		"paths": { "*": ["./src/*"] }
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts"
	]
}
